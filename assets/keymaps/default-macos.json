// 编辑器键位（macOS 专属），由 src/keymap/mod.rs 在 macOS 上追加加载。
[
  {
    "context": "Input",
    "bindings": {
      "ctrl-backspace": "editor::Backspace",
      "cmd-backspace": "editor::DeleteToBeginningOfLine",
      "cmd-delete": "editor::DeleteToEndOfLine",
      "alt-backspace": "editor::DeleteToPreviousWordStart",
      "alt-delete": "editor::DeleteToNextWordEnd",
      "cmd-]": "editor::Indent",
      "cmd-[": "editor::Outdent",
      "ctrl-shift-a": "editor::SelectToStartOfLine",
      "ctrl-shift-e": "editor::SelectToEndOfLine",
      "shift-cmd-left": "editor::SelectToStartOfLine",
      "shift-cmd-right": "editor::SelectToEndOfLine",
      "alt-shift-left": "editor::SelectToPreviousWordStart",
      "alt-shift-right": "editor::SelectToNextWordEnd",
      "ctrl-cmd-space": "editor::ShowCharacterPalette",
      "cmd-a": "editor::SelectAll",
      "cmd-c": "editor::Copy",
      "cmd-x": "editor::Cut",
      "cmd-v": "editor::Paste",
      "ctrl-a": "editor::MoveHome",
      "cmd-left": "editor::MoveHome",
      "ctrl-e": "editor::MoveEnd",
      "cmd-right": "editor::MoveEnd",
      "cmd-z": "editor::Undo",
      "cmd-shift-z": "editor::Redo",
      "cmd-up": "editor::MoveToStart",
      "cmd-down": "editor::MoveToEnd",
      "alt-left": "editor::MoveToPreviousWord",
      "alt-right": "editor::MoveToNextWord",
      "cmd-shift-up": "editor::SelectToStart",
      "cmd-shift-down": "editor::SelectToEnd",
      "cmd-f": "editor::Search",
      "cmd-/": "editor::ToggleComment",
      "cmd-shift-k": "editor::DeleteLine",
      "cmd-j": "editor::JoinLines",
      "alt-cmd-[": "editor::Fold",
      "alt-cmd-]": "editor::Unfold",
      "alt-cmd-l": "editor::ToggleFold",
      "alt-cmd-0": "editor::FoldAll",
      "alt-cmd-j": "editor::UnfoldAll",
      "alt-cmd-1": ["editor::FoldLevel", 1],
      "alt-cmd-2": ["editor::FoldLevel", 2],
      "alt-cmd-3": ["editor::FoldLevel", 3],
      "alt-cmd-4": ["editor::FoldLevel", 4],
      "alt-cmd-5": ["editor::FoldLevel", 5],
      "alt-cmd-6": ["editor::FoldLevel", 6],
      "alt-cmd-7": ["editor::FoldLevel", 7]
    }
  }
]
